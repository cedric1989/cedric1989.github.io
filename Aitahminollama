# AYARLAR
# ==========================================================

OLLAMA_MODEL = "qwen2.5:3b"
OLLAMA_URL = "http://localhost:11434/api/generate"

SIMULATION_DAYS = 21          # Yaklaşık 1 aylık işlem günü
SIMULATION_COUNT = 1000       # Her hisse için üretilecek senaryo sayısı
